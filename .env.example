# ──────────────────────────────────────────────────────────────────────────
#  Study Companion — configuration
#  Copy to `.env`. Every AI capability has its OWN base URL, API key and
#  model, so you can mix providers freely. Nothing else changes.
# ──────────────────────────────────────────────────────────────────────────
#
#  Three capabilities, three independent endpoints:
#
#    capability      BASE_URL               API_KEY            MODEL
#    --------------- ---------------------- ------------------ ---------------------------
#    chat (LLM)      LLM_BASE_URL           LLM_API_KEY        LLM_MODEL
#    embeddings      EMBEDDING_BASE_URL     EMBEDDING_API_KEY  EMBEDDING_MODEL
#    speech-to-text  TRANSCRIPTION_BASE_URL TRANSCRIPTION_API_KEY
#                                                 TRANSCRIPTION_MODEL
#
#  For embeddings and transcription, an unset BASE_URL / API_KEY inherits
#  LLM_BASE_URL / LLM_API_KEY — so a single-server setup only needs the LLM_*
#  lines. Models never inherit (model ids are provider-specific).
#
#  Set a *_BASE_URL to a different host and you MUST set its matching
#  *_API_KEY; the server logs a warning at boot if you forget.

# ── Option A: LM Studio (local, free) ────────────────────────────────────
#   Load a chat model + an embedding model in LM Studio, start the server.

LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-embeddinggemma-2
# EMBEDDING_DIM=768  # optional pin — unset means auto-detect from the model

# ── Option B: Groq (fast cloud Llama) ───────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# Groq has no /embeddings -> point embeddings at another OpenAI-compatible
# server (LM Studio, OpenAI):
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=lm-studio
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Speech-to-text can stay on Groq (inherit the LLM_* above) or move:
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Option C: OpenAI ─────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── Embeddings: cloud (default) or local vendored server ────────────────
# EMBEDDING_MODE=cloud (default) — the EMBEDDING_BASE_URL/API_KEY/MODEL lines
#   win (OpenAI, LM Studio, …). Nothing is downloaded. Mock/test runs use cloud.
# EMBEDDING_MODE=local — a llama.cpp server is downloaded to ./data/llama on
#   first USE (not at boot: only when local vectors are actually requested)
#   and serves on 127.0.0.1:8899 with wake-on-API and idle unload. EMBEDDING_*
#   URL/KEY/MODEL lines are ignored in this mode.
# Multimodal wire shape for image/audio/video vectors (text ALWAYS uses the
# OpenAI-compatible endpoint above, whatever you pick here):
#   EMBEDDING_PROTOCOL=auto      (default) sniffed from the host (Google ->
#                                 gemini, Jina -> jina, else llama_cpp shape)
#   EMBEDDING_PROTOCOL=llama_cpp  nested parts (self-hosted llama-server)
#   EMBEDDING_PROTOCOL=jina       typed objects (api.jina.ai + v5-omni models)
#   EMBEDDING_PROTOCOL=gemini     native embedContent with inline_data parts
# A .../v1beta/openai base URL keeps working with protocol=gemini (the native
# root is derived from it). Native calls accept output_dimensionality, so a
# pinned EMBEDDING_DIM is requested server-side instead of mismatching.
# Native modes (page images, audio/video vectors) need a protocol the endpoint
# really speaks — a text-only endpoint fails the boot guard loudly instead of
# corrupting retrieval.
# Layout + knobs (only read in local mode):
# EMBEDDING_LOCAL_DIR=./data/llama
# EMBEDDING_LOCAL_PORT=8899
# EMBEDDING_LOCAL_CTX=4096
# Longest single input the local server accepts (physical batch). Must cover
# your longest chunk; the client splits anything longer anyway.
# EMBEDDING_LOCAL_UBATCH_SIZE=2048
# Logical batch: upper bound the server clamps ubatch to — raise both together.
# Costs ~1 GB RAM at 8192; needed for >6 s video clips / very long chunks.
# EMBEDDING_LOCAL_BATCH_SIZE=2048
# Longest single input sent to /embeddings, in characters (any provider).
# Longer chunks are split and mean-pooled instead of failing the batch.
# EMBEDDING_MAX_INPUT_CHARS=1500
# EMBEDDING_LOCAL_REPO=ggml-org/embeddinggemma-2-GGUF
# EMBEDDING_LOCAL_MODEL_FILE=embeddinggemma-2-Q8_0.gguf
# EMBEDDING_LOCAL_MMPROJ_FILE=mmproj-embeddinggemma-2-Q8_0.gguf
# Or point at your own files instead of the managed download:
# EMBEDDING_LOCAL_MODEL_PATH=D:/Ai_models/embeddinggemma-2-Q8_0.gguf
# EMBEDDING_LOCAL_MMPROJ_PATH=D:/Ai_models/mmproj-F16.gguf
# Server unloads after this many idle seconds (0 = keep up forever):
# EMBEDDING_IDLE_UNLOAD_S=300  (5 min)
# Engine releases are fetched from this GitHub repo (Settings → Update engine):
# LLAMA_GITHUB_REPO=ggml-org/llama.cpp
# How lecture audio/video is vectorized: transcript text (default, works with
# any text embedding model) or the raw audio bytes of each ~20 s segment.
# NATIVE needs a joint audio-text embedding model sharing one vector space,
# served by an engine that really encodes bytes — LM Studio's embedding
# endpoint is text-only and tokenizes the data URI as text (verified:
# sine-vs-noise cosine 0.97). Serve e.g. embeddinggemma-2-GGUF + mmproj from
# llama.cpp, confirm with `uv run python scripts/probe_multimodal.py`, then
# switch. Chat can still hear retrieved clips (input_audio) in either mode
# when the chat model supports it. Switching modes re-vectors the corpus:
# re-ingest everything with `uv run python scripts/re_embed.py --force`.
# AUDIO_EMBED_MODE=transcript
# Native mode embeds each ~3 min audio part twice (transcript text + the 3-min
# audio clip of the same timeframe) so retrieval matches words and sound —
# the audio mirror of video transcript+clip parts.
# AUDIO_SEGMENT_SECONDS=180  (3-min audio parts)
# VIDEO_EMBED_MODE=transcript  (native = per-part video-clip vectors)
# Native mode embeds each ~10 s part as video (transcript stays the text) so
# retrieval matches words and motion. Working recipe (measured):
# EMBEDDING_LOCAL_VIDEO_FPS=1.0, VIDEO_CLIP_WIDTH=720 (≈1.7k tokens per part,
# fits ubatch 2048, ~2 s on GPU). Wider input is downscaled to the width;
# narrower passes through. Oversize clips fall back to stills with a warning.
# VIDEO_SEGMENT_SECONDS=10
# VIDEO_CLIP_SECONDS=0  (middle slice of this length instead of the full part)
# VIDEO_CLIP_WIDTH=720  (max width px)
# Every PDF page is also rendered to PNG and embedded as an image chunk, so
# charts/diagrams stay retrievable alongside the text. Needs the joint model
# above (text-only endpoints ingest text-only with a warning). Slides need
# LibreOffice, else text-only.
# PDF_PAGE_IMAGES=true
# PDF_PAGE_IMAGE_MAX_PAGES=200  (per-source render budget, 0 = all pages)

# ── Transcription (speech-to-text for lecture audio/video) ────────────
# TRANSCRIPTION_MODE=cloud (default) — any OpenAI-compatible
#   /audio/transcriptions endpoint; nothing is downloaded.
#   Groq (free):  TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
#                 TRANSCRIPTION_API_KEY=gsk_...
#                 TRANSCRIPTION_MODEL=whisper-large-v3-turbo
#   OpenAI:       TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
#                 TRANSCRIPTION_API_KEY=sk-...
#                 TRANSCRIPTION_MODEL=whisper-1
#   Self-hosted:  TRANSCRIPTION_BASE_URL=http://localhost:8000/v1
# TRANSCRIPTION_MODE=local — a vendored audio.cpp server is downloaded to
#   ./data/audio-cpp on first use (engine picked for your system: CUDA build
#   when nvidia-smi exists, else CPU; macOS gets Metal) plus the ASR weights
#   below, serving transcripts with timestamps on 127.0.0.1:8898 with
#   wake-on-API and 5-min idle unload. TRANSCRIPTION_*_URL/KEY lines are
#   ignored in this mode. Only one local engine stays resident: starting the
#   transcription server auto-unloads the embedding server and vice versa.
#   Cloud+cloud downloads nothing at all.
# TRANSCRIPTION_MODE=cloud
# TRANSCRIPTION_BASE_URL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Local audio.cpp layout + knobs (only read in local mode):
# TRANSCRIPTION_LOCAL_DIR=./data/audio-cpp
# TRANSCRIPTION_LOCAL_PORT=8898
# Engine releases are fetched from this GitHub repo:
# TRANSCRIPTION_LOCAL_REPO=0xShug0/audio.cpp
# Default ASR weights (MOSS-Transcribe-Diarize Q4_K: transcription + speaker
# labels + timestamps in one model; override the path to use your own files
# instead of the managed download):
# TRANSCRIPTION_LOCAL_MODEL_REPO=audio-cpp/audio.cpp-gguf
# TRANSCRIPTION_LOCAL_MODEL_FILE=MOSS-Transcribe-Diarize-GGUF/moss-transcribe-diarize-q4_k.gguf
# TRANSCRIPTION_LOCAL_MODEL_PATH=D:/Ai_models/moss-transcribe-diarize-q4_k.gguf
# TRANSCRIPTION_LOCAL_MODEL_ID=moss-transcribe-diarize
# TRANSCRIPTION_LOCAL_FAMILY=moss_transcribe_diarize
# Server unloads after this many idle seconds (0 = keep up forever):
# TRANSCRIPTION_IDLE_UNLOAD_S=300  (5 min)
# Some self-hosted STT servers reject verbose_json without a language hint.
# Set this (e.g. "en") if transcription fails with a 501 about language.
# TRANSCRIPTION_LANGUAGE=en
# Longest audio slice per transcription request (any STT endpoint, cloud or
# local). Must fit the MODEL's encoder window, not just upload limits: 10-min
# pieces against Parakeet TDT fail with "relative position frames exceed
# maximum" while 5 min works. Test the model directly, then set at/below what
# worked: 60/120/180/300 for 1/2/3/5 min. Video pieces and long audio files
# are split to this size automatically.
# TRANSCRIPTION_CHUNK_S=300

# ── Video keyframes (visual track for lecture videos) ────────────────────
# One frame per Nth ~20 s segment is captioned by the vision chat model and
# the caption joins the segment text — same locator, same chunk, so slides
# and diagrams become searchable with any text embedder. Needs ffmpeg and a
# vision-capable chat model; anything else degrades to transcript-only.
# VIDEO_CAPTIONS=true
# VIDEO_FRAME_EVERY_N=3
# VIDEO_FRAME_WIDTH=640
# VIDEO_MAX_FRAMES=120

# ── llama.cpp as the embedding server (native multimodal vectors) ─────────
# 1. Download the joint model + projector, e.g. ggml-org/embeddinggemma-2-GGUF
#    (weights + mmproj file).
# 2. llama-server --embedding --mmproj <mmproj.gguf> -m <model.gguf> -c 2048 --port 8081
# 3. Point only the embedding capability at it, then PROVE it encodes bytes:
#      EMBEDDING_BASE_URL=http://localhost:8081/v1
#      EMBEDDING_API_KEY=x
#      EMBEDDING_MODEL=<the served model id>
#      uv run python scripts/probe_multimodal.py   # must print NATIVE OK
# 4. Only then: AUDIO_EMBED_MODE=native and/or VIDEO_EMBED_MODE=native,
#    then re-ingest (`scripts/re_embed.py --force`). The server refuses to
#    boot in native modes when the probe fails, so a text-only endpoint can
#    never silently corrupt retrieval.

# Example mix: Groq for chat + OpenAI for embeddings + Groq for Whisper
# (transcription needs no key here — it inherits LLM_API_KEY=gsk_...).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Firecrawl (PDF -> per-page Markdown). Leave empty to use local pdf-inspector/anydoc ─
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL= http://127.0.0.1:7654
FIRECRAWL_MAX_PAGES=100
# auto | firecrawl | local
PARSER=auto

# ── Memory assembly (Phase E: explicit token budgets) ────────────────────
# One chat turn = global block + project block + chat summary + recent turns
# + retrieved context. Budgets keep memory from crowding out context.
# MEMORY_CHAT_WINDOW=10
# MEMORY_SUMMARIZE_THRESHOLD=30
# MEMORY_MAX_FACTS_GLOBAL=8
# MEMORY_MAX_TOPICS=6
# MEMORY_CONTEXT_CHARS=6000
# MEMORY_REWRITE=true
# MEMORY_REFINE_EVERY=6

# ── RAG tuning ───────────────────────────────────────────────────────────
TOP_K=6
# Refuse before calling the LLM if the best chunk's cosine distance is above this
MAX_DISTANCE=0.8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
LLM_TEMPERATURE=0.1

# ── Learner model (Bayesian Knowledge Tracing) ───────────────────────────
BKT_P_INIT=0.30
BKT_P_TRANSIT=0.15
BKT_P_SLIP=0.10
BKT_P_GUESS=0.25
QUIZ_QUESTIONS=3
MAX_TOPICS=8

# ── Misc ─────────────────────────────────────────────────────────────────
# Uploaded files land in DATA_DIR/uploads/<project_id>/<source_id>.<ext>.
# Nothing is uploaded off this machine.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (OPTIONAL) ─────────────────────────────────────────────────
# Two backends, same API:
#   Set DATABASE_URL (postgresql://...) -> Postgres + pgvector (website).
#   Leave it unset                    -> SQLite + ChromaDB under DATA_DIR
#                                        (desktop default: zero-install).
#   DATABASE_URL=sqlite:///path/to.db  -> explicit SQLite file (tests).
# Postgres needs the pgvector extension (`create extension vector`).
# Create the database once:  createdb StudyCompanion
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/StudyCompanion
DB_POOL_MIN=1
DB_POOL_MAX=10

# Optional pin for your embedding model's output width — 1536 for OpenAI
# text-embedding-3-small, 768 for nomic-embed-text or Google EmbeddingGemma,
# 3072 for OpenAI text-embedding-3-large. Leave unset (default) for auto-detect:
# one /embeddings probe at boot wins, fresh migrations are templated to it.
# Set it only to lock a website deployment to a known width.
# Changing models? Run `uv run python scripts/re_embed.py` (--check first).
# It resizes the column and re-ingests every stored file.
# Never use `migrate.py --reset` for this — it drops users, projects and files.
# EMBEDDING_DIM=1536

# Per-type upload ceilings in MB. Video/audio are larger because they are the
# expensive kinds to ingest (transcription + embedding).
MAX_UPLOAD_MB=50
MAX_VIDEO_MB=300
MAX_AUDIO_MB=100


# ── Auth ─────────────────────────────────────────────────────────────────
# Signing key for the session tokens this app issues. Leave empty on first
# run: the server generates one and saves it to `.env` automatically.
# Generate manually if you prefer:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_S=604800

