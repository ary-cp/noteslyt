# ──────────────────────────────────────────────────────────────────────────
#  Study Companion — configuration
#  Copy to `.env`. Every AI capability has its OWN base URL, API key and
#  model, so you can mix providers freely. Nothing else changes.
# ──────────────────────────────────────────────────────────────────────────
#
#  Three capabilities, three independent endpoints:
#
#    capability      BASE_URL               API_KEY            MODEL
#    --------------- ---------------------- ------------------ ---------------------------
#    chat (LLM)      LLM_BASE_URL           LLM_API_KEY        LLM_MODEL
#    embeddings      EMBEDDING_BASE_URL     EMBEDDING_API_KEY  EMBEDDING_MODEL
#    speech-to-text  TRANSCRIPTION_BASE_URL TRANSCRIPTION_API_KEY
#                                                 TRANSCRIPTION_MODEL
#
#  For embeddings and transcription, an unset BASE_URL / API_KEY inherits
#  LLM_BASE_URL / LLM_API_KEY — so a single-server setup only needs the LLM_*
#  lines. Models never inherit (model ids are provider-specific).
#
#  Set a *_BASE_URL to a different host and you MUST set its matching
#  *_API_KEY; the server logs a warning at boot if you forget.

# ── Option A: LM Studio (local, free) ────────────────────────────────────
#   Load a chat model + an embedding model in LM Studio, start the server.

LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ── Option B: Groq (fast cloud Llama) ───────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# Groq has no /embeddings -> point embeddings at another OpenAI-compatible
# server (LM Studio, OpenAI):
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=lm-studio
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Speech-to-text can stay on Groq (inherit the LLM_* above) or move:
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Option C: OpenAI ─────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── Embeddings on a different server than chat ───────────────────────────
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=lm-studio

# ── Transcription (speech-to-text for lecture videos) ──────────────────
# Any OpenAI-compatible /audio/transcriptions endpoint. Defaults to
# LLM_BASE_URL / LLM_API_KEY when unset.
#   Groq (free):  TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
#                 TRANSCRIPTION_API_KEY=gsk_...
#                 TRANSCRIPTION_MODEL=whisper-large-v3-turbo
#   OpenAI:       TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
#                 TRANSCRIPTION_API_KEY=sk-...
#                 TRANSCRIPTION_MODEL=whisper-1
#   Self-hosted:  TRANSCRIPTION_BASE_URL=http://localhost:8000/v1
# TRANSCRIPTION_BASE_URL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Example mix: Groq for chat + OpenAI for embeddings + Groq for Whisper
# (transcription needs no key here — it inherits LLM_API_KEY=gsk_...).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Firecrawl (PDF -> per-page Markdown). Leave empty to use local pdf-inspector/anydoc ─
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL= http://127.0.0.1:7654
FIRECRAWL_MAX_PAGES=100
# auto | firecrawl | local
PARSER=auto

# ── Memory assembly (Phase E: explicit token budgets) ────────────────────
# One chat turn = global block + project block + chat summary + recent turns
# + retrieved context. Budgets keep memory from crowding out context.
# MEMORY_CHAT_WINDOW=10
# MEMORY_SUMMARIZE_THRESHOLD=30
# MEMORY_MAX_FACTS_GLOBAL=8
# MEMORY_MAX_TOPICS=6
# MEMORY_CONTEXT_CHARS=6000
# MEMORY_REWRITE=true
# MEMORY_REFINE_EVERY=6

# ── RAG tuning ───────────────────────────────────────────────────────────
TOP_K=6
# Refuse before calling the LLM if the best chunk's cosine distance is above this
MAX_DISTANCE=0.8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
LLM_TEMPERATURE=0.1

# ── Learner model (Bayesian Knowledge Tracing) ───────────────────────────
BKT_P_INIT=0.30
BKT_P_TRANSIT=0.15
BKT_P_SLIP=0.10
BKT_P_GUESS=0.25
QUIZ_QUESTIONS=3
MAX_TOPICS=8

# ── Misc ─────────────────────────────────────────────────────────────────
# Uploaded files land in DATA_DIR/uploads/<project_id>/<source_id>.<ext>.
# Nothing is uploaded off this machine.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (REQUIRED) ───────────────────────────────────────────────────
# One local Postgres instance with the pgvector extension available.
# Create the database once:  createdb StudyCompanion
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/StudyCompanion
DB_POOL_MIN=1
DB_POOL_MAX=10

# Must equal your embedding model's output width — 1536 for OpenAI
# text-embedding-3-small, 768 for nomic-embed-text or Google EmbeddingGemma,
# 3072 for OpenAI text-embedding-3-large. The server refuses to boot and
# `scripts/migrate.py` refuses to run when this disagrees with the database.
# Changing models? Set the new width, then run `uv run python scripts/re_embed.py`
# (--check first). It resizes the column and re-ingests every stored file.
# Never use `migrate.py --reset` for this — it drops users, projects and files.
EMBEDDING_DIM=1536

# Per-type upload ceilings in MB. Video/audio are larger because they are the
# expensive kinds to ingest (transcription + embedding).
MAX_UPLOAD_MB=50
MAX_VIDEO_MB=300
MAX_AUDIO_MB=100


# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Signing key for the session tokens this app issues. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start without it, so a misconfigured setup fails loudly
# instead of silently accepting no logins.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_S=604800

