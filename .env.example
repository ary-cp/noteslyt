# ──────────────────────────────────────────────────────────────────────────
#  Study Companion — configuration
#  Copy to `.env` and pick ONE provider block. Nothing else changes.
# ──────────────────────────────────────────────────────────────────────────

# ── Option A: LM Studio (local, free) ────────────────────────────────────
#   Load a chat model + an embedding model in LM Studio, start the server.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ── Option B: Groq (fast cloud Llama; no embeddings API -> use local) ────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_PROVIDER=local

# ── Option C: OpenAI ─────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Embeddings may come from a different server than the chat model:
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=lm-studio

# ── Firecrawl (PDF -> per-page Markdown). Leave empty to use local pdf-inspector/anydoc ─
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_MAX_PAGES=100
# auto | firecrawl | local
PARSER=auto

# ── RAG tuning ───────────────────────────────────────────────────────────
TOP_K=6
# Refuse before calling the LLM if the best chunk's cosine distance is above this
MAX_DISTANCE=0.8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
LLM_TEMPERATURE=0.1

# ── Learner model (Bayesian Knowledge Tracing) ───────────────────────────
BKT_P_INIT=0.30
BKT_P_TRANSIT=0.15
BKT_P_SLIP=0.10
BKT_P_GUESS=0.25
QUIZ_QUESTIONS=3
MAX_TOPICS=8

# ── Misc ─────────────────────────────────────────────────────────────────
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
