# Reproducible real-model eval config. Copy to .env-test and fill keys.
# The API server keeps using root .env; eval/run_real.py reads THIS file
# only to (a) verify the server matches it and (b) stamp results with it.
# Same data (eval/dataset seed) + same model (below) + same settings = reproducible.

# --- server under test ---
EVAL_BASE_URL=http://127.0.0.1:8000
EVAL_SEED=42
EVAL_TIER=50

# --- chat / generation ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini

# --- embeddings (mode selects construction site in app/backend.py) ---
EMBEDDING_MODE=cloud
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-change-me
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty for auto-detect; set only to pin a website deployment width.
EMBEDDING_DIM=

# --- transcription (audio/video) ---
TRANSCRIPTION_MODE=cloud
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=sk-change-me
TRANSCRIPTION_MODEL=whisper-1
